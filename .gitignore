# Secrets and credentials
**/.env
**/.env.*
**/*.key
**/*.pem
**/*secret*
**/*token*
**/credentials*
**/hosts.yml

# OBS websocket password
scripts/bin/obs-password

# Passphrase helper
scripts/bin/pass

# Journal script (machine-local)
scripts/bin/obsidian-journal.sh

# Python
**/__pycache__/
**/*.pyc

# Logs, backups, and temporary files
**/*.log
**/*.tmp
**/*.bak
**/*~

# Sublime transient state
**/*.sublime-workspace
**/*.sublime_session
sublime/.config/sublime-text/Packages/User/Package Control.last-run
sublime/.config/sublime-text/Packages/User/Package Control.cache
sublime/.config/sublime-text/Packages/User/Package Control.ca-list
sublime/.config/sublime-text/Packages/User/Package Control.merged-ca-bundle

# General junk
.DS_Store
Thumbs.db

# Generated or backup configuration files
sublime/.config/sublime-text/Packages/User/Package Control.user-ca-bundle
ytjukebox/.config/ytjukebox/playlist.toml.save

# Generated by ~/bin/wallpaper-theme (matugen) -- regenerated from the wallpaper, not tracked
sublime/.config/sublime-text/Packages/User/Wallpaper.sublime-color-scheme
hypr/.config/hypr/hyprtoolkit.conf

# Generated by ~/bin/wallpaper-theme (fastfetch config + spinning logo follow the wallpaper)
fastfetch/.config/fastfetch/config.jsonc
fastfetch/.config/fastfetch/airbender.gif

# Generated per user by ~/bin/wallpaper-theme-gtk (they hold an absolute path to that user's theme)
gtk/.config/gtk-4.0/gtk.css
gtk/.config/gtk-4.0/gtk-dark.css
