#!/usr/bin/env python3
"""waybar-logme: a heart-pulse icon on the bar until today has an entry in the Health Tracker.

Reads ~/Applications/health-tracker/health_data.json (synced by Seafile, so logging on either machine
clears it on both). The tracker only stores a day once something was saved for it, so a present
key means "logged". Prints empty text (module hidden) when today is logged or there's no data file.

Waybar: "custom/logme": { "exec": "$HOME/bin/waybar-logme", "return-type": "json",
                          "interval": 300, "signal": 10, ... }   (~/bin/health-tracker sends signal 10)
"""
import datetime
import json
import os

DATA = os.path.expanduser("~/Applications/health-tracker/health_data.json")
ICON = "\U000f05f6"   # nerd-font heart pulse


def main():
    try:
        with open(DATA, encoding="utf-8") as f:
            entries = json.load(f).get("entries", {})
    except (OSError, ValueError, AttributeError):
        print(json.dumps({"text": ""}))
        return
    today = datetime.date.today().isoformat()
    if entries.get(today):
        print(json.dumps({"text": ""}))
    else:
        print(json.dumps({"text": ICON, "class": "due",
                          "tooltip": f"No Health Tracker entry for {today} yet.\nClick to log the day."}))


if __name__ == "__main__":
    main()
