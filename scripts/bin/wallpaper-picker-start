#!/usr/bin/env bash
# Login hook (wallpaper-picker-start.service): apply the saved Wallpaper Engine setup, which also
# re-themes the desktop and (re)starts Waybar. On an account with nothing saved yet (no Steam
# Workshop wallpapers picked), still make sure the theme files exist and Waybar is running.
set -uo pipefail

ready=false
for ((attempt = 1; attempt <= 50; attempt++)); do
    if /usr/bin/hyprctl monitors -j >/dev/null 2>&1; then
        ready=true
        break
    fi
    sleep 0.2
done
if [[ "$ready" != true ]]; then
    echo "Hyprland was not ready after 10 seconds." >&2
    exit 1
fi

# A non-default desktop theme (~/bin/theme) brings its own desk instead of the Wallpaper Engine one.
theme="$(tr -d '[:space:]' <"$HOME/.local/state/desktop-theme/current" 2>/dev/null)"
if [[ -n "$theme" && "$theme" != wallpaper ]]; then
    exec "$HOME/bin/theme" --login
fi

if "$HOME/.local/bin/wallpaper-picker" --apply-saved; then
    exit 0
fi

echo "No saved wallpaper was applied; starting Waybar without one." >&2
if [[ ! -f "$HOME/.cache/wallpaper-theme/waybar-colors.css" ]]; then
    "$HOME/bin/wallpaper-theme" --image /usr/share/hypr/wall0.png --no-reload --no-restart-apps || true
fi
"$HOME/bin/waybar-start"
