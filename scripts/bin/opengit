#!/usr/bin/env bash
# opengit [repo]: open a workspace for a repo in ~/GitHub. Sublime top left with the build
# terminal under it (the tmux session Sublime's Native Run build sends output to, so it doubles
# as the shell), lazygit top right, yazi bottom right. With no argument, pick the repo from a
# list (the Alt+S launcher). The Obsidian vault is left out on purpose. Run from a terminal,
# that terminal closes first so the layout starts from an empty desktop.
set -euo pipefail

root="$HOME/GitHub"

if [[ $# -ge 1 ]]; then
    dir="$1"
    [[ "$dir" == /* ]] || dir="$root/$dir"
else
    pick="$(for d in "$root"/*/; do
                n="$(basename "$d")"
                [[ -e "$d/.git" && "$n" != Obsidian ]] && echo "$n"
            done | hyprlauncher --dmenu)" || exit 0
    [[ -n "$pick" ]] || exit 0
    dir="$root/$pick"
fi
[[ -d "$dir" ]] || { echo "opengit: no such folder: $dir" >&2; exit 1; }

# Started from a kitty window: carry on detached, so closing that window doesn't stop us.
if [[ -z "${OPENGIT_DETACHED:-}" ]]; then
    p=$PPID term=""
    while [[ "$p" -gt 1 ]]; do
        [[ "$(cat /proc/$p/comm 2>/dev/null)" == kitty ]] && { term=$p; break; }
        p="$(awk '{print $4}' /proc/$p/stat 2>/dev/null || echo 1)"
    done
    if [[ -n "$term" ]]; then
        OPENGIT_DETACHED=1 OPENGIT_CLOSE="$term" setsid -f "$(readlink -f "$0")" "$dir" \
            </dev/null >/dev/null 2>&1
        exit 0
    fi
fi

# start a program, wait for its window (new windows take focus) and print its pid
launch() {
    local before; before="$(hyprctl clients -j | jq -c '[.[].address]')"
    setsid -f "$@" </dev/null >/dev/null 2>&1
    for _ in $(seq 50); do
        local pid; pid="$(hyprctl clients -j | jq -r --argjson b "$before" \
            'map(select(.address as $a | $b | index($a) | not)) | .[0].pid // empty')"
        [[ -n "$pid" ]] && { echo "$pid"; return; }
        sleep 0.1
    done
    echo "opengit: no window from: $*" >&2
}

if [[ -n "${OPENGIT_CLOSE:-}" ]]; then
    hyprctl dispatch "hl.dsp.window.close({ window = \"pid:$OPENGIT_CLOSE\" })" >/dev/null
    for _ in $(seq 30); do
        hyprctl clients -j | jq -e --argjson p "$OPENGIT_CLOSE" 'any(.pid == $p)' >/dev/null || break
        sleep 0.1
    done
fi

# Dwindle splits the focused window; preselect picks the side (otherwise the mouse decides).
side() { hyprctl dispatch "hl.dsp.layout(\"preselect $1\")" >/dev/null; }
# an already-running build session gets moved to this repo if it's sitting at a shell prompt
if [[ "$(tmux display -p -t sublime-build '#{pane_current_command}' 2>/dev/null)" == bash ]]; then
    tmux send-keys -t sublime-build "cd $(printf '%q' "$dir") && clear" Enter
fi
build="$(launch kitty --title "Sublime Build" --directory "$dir" tmux new-session -A -s sublime-build -c "$dir")"
side r; lazy="$(launch kitty --directory "$dir" lazygit)"
side d; launch kitty --directory "$dir" yazi >/dev/null
[[ -n "$build" ]] && hyprctl dispatch "hl.dsp.focus({ window = \"pid:$build\" })" >/dev/null
side u; launch subl -n "$dir" >/dev/null

# Sizes: Sublime ~73% wide and ~74% tall, lazygit ~56% of the right column (Sublime is focused
# now; it shares a pid with every other Sublime window, so it's resized as the active window).
read -r x0 y0 w h < <(hyprctl activewindow -j | jq -r '"\(.at[0]) \(.at[1]) \(.size[0]) \(.size[1])"')
read -r x1 y1 < <(hyprctl clients -j | jq -r --argjson b "${build:-0}" --argjson l "${lazy:-0}" \
    '(map(select(.pid == $l))[0] | .at[0] + .size[0]) as $r
     | (map(select(.pid == $b))[0] | .at[1] + .size[1]) as $d | "\($r) \($d)"')
if [[ "$x1" =~ ^[0-9]+$ && "$y1" =~ ^[0-9]+$ ]]; then
    W=$((x1 - x0)) H=$((y1 - y0))
    hyprctl dispatch "hl.dsp.window.resize({ x = $((W * 733 / 1000)), y = $((H * 740 / 1000)), relative = false })" >/dev/null
    hyprctl dispatch "hl.dsp.window.resize({ x = $((W - W * 733 / 1000 - 14)), y = $((H * 562 / 1000)), relative = false, window = \"pid:$lazy\" })" >/dev/null
fi
