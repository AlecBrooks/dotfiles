#!/usr/bin/env python3
"""Follow (and optionally send to) a YouTube live stream's chat in the terminal.

Usage:
  ytchat <youtube-url>     show chat; if logged in, type a line + Enter to send
  ytchat --login           sign in with your YouTube account (one time)
  ytchat --logout          forget the saved sign-in

Reading: yt-dlp saves live chat as a "live_chat" subtitle track that keeps
growing while the stream is live. This follows that file and prints each
message as "name: text". No account or API quota needed.

Sending: uses the official YouTube Data API (liveChatMessages.insert, ~50 quota
units per message out of 10,000/day). Needs a Google Cloud OAuth "Desktop app"
client saved as ~/.config/ytchat/client_secret.json; the sign-in token is kept
in ~/.config/ytchat/token.json (mode 600). Ctrl+C to quit.
"""
import base64
import ctypes
import hashlib
import http.server
import json
import os
import re
import secrets
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.parse
import urllib.request

NAME = "\033[1;36m"      # bold cyan
MEMBER = "\033[1;32m"    # bold green (channel members)
MOD = "\033[1;34m"       # bold blue (moderators / owner)
PAID = "\033[1;33m"      # bold yellow (Super Chats)
ERROR = "\033[1;31m"
SELF = "\033[1;35m"      # bold magenta: your own messages
MENTION = "\033[1;30;43m"  # black on yellow: messages that @ you
BOLD = "\033[1m"
DIM = "\033[2m"
RESET = "\033[0m"
PROMPT = "> "

CONFIG_DIR = os.path.expanduser("~/.config/ytchat")
CLIENT_FILE = os.path.join(CONFIG_DIR, "client_secret.json")
TOKEN_FILE = os.path.join(CONFIG_DIR, "token.json")
SCOPE = "https://www.googleapis.com/auth/youtube.force-ssl"
API = "https://www.googleapis.com/youtube/v3"


# ---------------------------------------------------------------- output

# When sending is enabled, the user's half-typed line lives on the bottom row.
# Every printed message clears that row, prints, then redraws prompt + buffer.
_print_lock = threading.Lock()
_interactive = False
_prompt_shown = False    # True only while input() is waiting on the bottom row
_me_id = None            # your channel id, once signed in
_me_mention = None       # regex matching "@yourhandle"


def show(text):
    with _print_lock:
        if _interactive and _prompt_shown:
            import readline
            sys.stdout.write("\r\033[K" + text + "\n" + PROMPT + readline.get_line_buffer())
            sys.stdout.flush()
        else:
            print(text, flush=True)


# ---------------------------------------------------------------- chat parsing

def runs_text(message):
    parts = []
    for run in message.get("runs", []):
        if "text" in run:
            parts.append(run["text"])
        elif "emoji" in run:
            emoji = run["emoji"]
            if emoji.get("isCustomEmoji"):
                shortcuts = emoji.get("shortcuts") or [":emoji:"]
                parts.append(shortcuts[0])
            else:
                parts.append(emoji.get("emojiId", ""))
    return "".join(parts)


def name_color(renderer):
    for badge in renderer.get("authorBadges", []):
        icon = badge.get("liveChatAuthorBadgeRenderer", {}).get("icon", {}).get("iconType", "")
        if icon in ("MODERATOR", "OWNER"):
            return MOD
        if badge.get("liveChatAuthorBadgeRenderer", {}).get("customThumbnail"):
            return MEMBER
    return NAME


def format_item(item):
    if "liveChatTextMessageRenderer" in item:
        r = item["liveChatTextMessageRenderer"]
        name = r.get("authorName", {}).get("simpleText", "?")
        text = runs_text(r.get("message", {}))
        if not text.strip():
            return None
        if _me_id and r.get("authorExternalChannelId") == _me_id:
            return f"{SELF}{name}: {text}{RESET}"
        if _me_mention and _me_mention.search(text):
            return f"{MENTION} {name}: {text} {RESET}"
        return f"{name_color(r)}{name}{RESET}: {text}"
    if "liveChatPaidMessageRenderer" in item:
        r = item["liveChatPaidMessageRenderer"]
        name = r.get("authorName", {}).get("simpleText", "?")
        amount = r.get("purchaseAmountText", {}).get("simpleText", "")
        text = runs_text(r.get("message", {}))
        return f"{PAID}[{amount}] {name}{RESET}: {text}"
    if "liveChatMembershipItemRenderer" in item:
        r = item["liveChatMembershipItemRenderer"]
        name = r.get("authorName", {}).get("simpleText", "?")
        return f"{DIM}{name} became a member{RESET}"
    return None


def handle_line(line):
    try:
        data = json.loads(line)
    except json.JSONDecodeError:
        return
    actions = data.get("replayChatItemAction", {}).get("actions", [])
    for action in actions:
        item = action.get("addChatItemAction", {}).get("item")
        if item:
            text = format_item(item)
            if text:
                show(text)


# ---------------------------------------------------------------- OAuth

def http_json(url, data=None, headers=None, method=None):
    """Request url; returns (status, parsed JSON or {})."""
    body = None
    headers = dict(headers or {})
    if isinstance(data, dict) and headers.get("Content-Type") == "application/json":
        body = json.dumps(data).encode()
    elif data is not None:
        body = urllib.parse.urlencode(data).encode()
    request = urllib.request.Request(url, data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            return response.status, json.loads(response.read() or b"{}")
    except urllib.error.HTTPError as error:
        try:
            return error.code, json.loads(error.read() or b"{}")
        except json.JSONDecodeError:
            return error.code, {}


def load_client():
    if not os.path.exists(CLIENT_FILE):
        sys.exit(f"missing {CLIENT_FILE}\n"
                 "Create a Google Cloud OAuth 'Desktop app' client and save its JSON there.")
    with open(CLIENT_FILE) as f:
        data = json.load(f)
    client = data.get("installed") or data.get("web")
    if not client:
        sys.exit(f"{CLIENT_FILE} doesn't look like an OAuth client file")
    return client


def save_token(token):
    os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
    tmp = TOKEN_FILE + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(token, f)
    os.replace(tmp, TOKEN_FILE)


def login():
    """Installed-app OAuth flow: loopback redirect + PKCE, opens the browser."""
    client = load_client()
    verifier = secrets.token_urlsafe(64)
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    state = secrets.token_urlsafe(16)
    result = {}

    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            query = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            if query.get("state", [""])[0] == state:
                result["code"] = query.get("code", [None])[0]
                result["error"] = query.get("error", [None])[0]
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.end_headers()
            self.wfile.write(b"ytchat: signed in, you can close this tab." if result.get("code")
                             else b"ytchat: sign-in failed, check the terminal.")

        def log_message(self, *args):
            pass

    server = http.server.HTTPServer(("127.0.0.1", 0), Handler)
    redirect = f"http://127.0.0.1:{server.server_port}"
    url = client["auth_uri"] + "?" + urllib.parse.urlencode({
        "client_id": client["client_id"],
        "redirect_uri": redirect,
        "response_type": "code",
        "scope": SCOPE,
        "access_type": "offline",
        "prompt": "consent",
        "state": state,
        "code_challenge": challenge,
        "code_challenge_method": "S256",
    })
    print("Opening your browser to sign in. If it doesn't open, visit:\n" + url + "\n")
    subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    server.timeout = 300
    while "code" not in result and "error" not in result:
        server.handle_request()
        if not result:
            sys.exit("timed out waiting for the browser sign-in")
    server.server_close()
    if not result.get("code"):
        sys.exit(f"sign-in failed: {result.get('error')}")

    status, token = http_json(client["token_uri"], {
        "code": result["code"],
        "client_id": client["client_id"],
        "client_secret": client.get("client_secret", ""),
        "redirect_uri": redirect,
        "grant_type": "authorization_code",
        "code_verifier": verifier,
    })
    if status != 200 or "refresh_token" not in token:
        sys.exit(f"token exchange failed ({status}): {token}")
    token["expires_at"] = time.time() + token.get("expires_in", 3600) - 60
    save_token(token)
    print(f"Signed in. Token saved to {TOKEN_FILE}")


def access_token():
    """A valid access token, refreshing it if needed; None if not logged in."""
    if not os.path.exists(TOKEN_FILE):
        return None
    with open(TOKEN_FILE) as f:
        token = json.load(f)
    if time.time() < token.get("expires_at", 0):
        return token["access_token"]
    client = load_client()
    status, fresh = http_json(client["token_uri"], {
        "client_id": client["client_id"],
        "client_secret": client.get("client_secret", ""),
        "refresh_token": token["refresh_token"],
        "grant_type": "refresh_token",
    })
    if status != 200:
        raise RuntimeError(f"sign-in expired, run: ytchat --login ({fresh.get('error', status)})")
    token["access_token"] = fresh["access_token"]
    token["expires_at"] = time.time() + fresh.get("expires_in", 3600) - 60
    save_token(token)
    return token["access_token"]


def api_error(body, status):
    error = body.get("error", {})
    if isinstance(error, dict):
        return error.get("message") or f"HTTP {status}"
    return str(error or f"HTTP {status}")


# ---------------------------------------------------------------- sending

def video_id(url):
    match = re.search(r"(?:v=|youtu\.be/|/live/|/shorts/)([A-Za-z0-9_-]{11})", url)
    if match:
        return match.group(1)
    out = subprocess.run(["yt-dlp", "--quiet", "--no-warnings", "--print", "id", url],
                         capture_output=True, text=True)
    return out.stdout.strip() or None


def load_me():
    """Your channel id and @handle, used to highlight your messages and @mentions."""
    global _me_id, _me_mention
    status, body = http_json(f"{API}/channels?part=snippet&mine=true",
                             headers={"Authorization": f"Bearer {access_token()}"})
    items = body.get("items", []) if status == 200 else []
    if not items:
        return
    _me_id = items[0]["id"]
    handle = items[0].get("snippet", {}).get("customUrl", "")
    if handle:
        if not handle.startswith("@"):
            handle = "@" + handle
        _me_mention = re.compile(re.escape(handle) + r"(?![\w.-])", re.IGNORECASE)


def live_chat_id(vid):
    status, body = http_json(
        f"{API}/videos?part=liveStreamingDetails&id={vid}",
        headers={"Authorization": f"Bearer {access_token()}"})
    if status != 200:
        raise RuntimeError(api_error(body, status))
    items = body.get("items", [])
    chat = items[0].get("liveStreamingDetails", {}).get("activeLiveChatId") if items else None
    if not chat:
        raise RuntimeError("this stream has no active live chat")
    return chat


def send_message(chat_id, text):
    status, body = http_json(
        f"{API}/liveChat/messages?part=snippet",
        {"snippet": {"liveChatId": chat_id, "type": "textMessageEvent",
                     "textMessageDetails": {"messageText": text}}},
        headers={"Authorization": f"Bearer {access_token()}",
                 "Content-Type": "application/json"},
        method="POST")
    if status != 200:
        raise RuntimeError(api_error(body, status))


def input_loop(chat_id):
    """Runs in a thread: each typed line is sent; it shows up via the chat feed."""
    global _prompt_shown
    while True:
        with _print_lock:
            _prompt_shown = True
        try:
            text = input(PROMPT).strip()
        except EOFError:
            with _print_lock:
                _prompt_shown = False
            show(f"{DIM}input closed, still showing chat{RESET}")
            return
        # input() leaves the typed line on screen; wipe it so the chat stays clean.
        with _print_lock:
            _prompt_shown = False
            sys.stdout.write("\033[1A\r\033[K")
            sys.stdout.flush()
        if not text:
            continue
        try:
            send_message(chat_id, text[:200])
        except Exception as error:  # show any send failure without killing the reader
            show(f"{ERROR}not sent: {error}{RESET}")


# ---------------------------------------------------------------- main

def interrupted(signum, frame):
    raise KeyboardInterrupt


def die_with_parent():
    """Runs in the yt-dlp child: the kernel sends it SIGTERM if ytchat dies, even by SIGKILL."""
    try:
        ctypes.CDLL(None, use_errno=True).prctl(1, signal.SIGTERM)  # PR_SET_PDEATHSIG
    except Exception:
        pass


def watch(url):
    global _interactive
    # Ctrl+C, kill, and closing the terminal window all stop yt-dlp and clean up.
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, interrupted)

    tmp = tempfile.mkdtemp(prefix="ytchat-")
    proc = subprocess.Popen(
        ["yt-dlp", "--quiet", "--no-warnings", "--skip-download",
         "--write-subs", "--sub-langs", "live_chat",
         "-o", os.path.join(tmp, "chat.%(ext)s"), url],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
        start_new_session=True, preexec_fn=die_with_parent,
    )
    print(f"{DIM}connecting to chat...{RESET}", flush=True)

    if os.path.exists(TOKEN_FILE) and sys.stdin.isatty():
        try:
            vid = video_id(url)
            if not vid:
                raise RuntimeError("couldn't find the video id in that link")
            chat_id = live_chat_id(vid)
            load_me()
            _interactive = True
            threading.Thread(target=input_loop, args=(chat_id,), daemon=True).start()
            show(f"{DIM}signed in: type a message and press Enter to send{RESET}")
        except Exception as error:
            show(f"{ERROR}sending disabled: {error}{RESET}")

    partial = os.path.join(tmp, "chat.live_chat.json.part")
    final = os.path.join(tmp, "chat.live_chat.json")
    handle = None
    buffer = ""
    try:
        while True:
            if handle is None:
                for path in (partial, final):
                    if os.path.exists(path):
                        handle = open(path, encoding="utf-8", errors="replace")
                        break
            if handle is not None:
                chunk = handle.read()
                if chunk:
                    buffer += chunk
                    *lines, buffer = buffer.split("\n")
                    for line in lines:
                        handle_line(line)
                    continue
            if proc.poll() is not None:
                if handle is None:
                    err = proc.stderr.read().decode(errors="replace").strip()
                    show(err or "no live chat found (is the stream live?)")
                    return 1
                show(f"{DIM}chat ended{RESET}")
                return 0
            time.sleep(0.3)
    except KeyboardInterrupt:
        return 0
    finally:
        if proc.poll() is None:
            os.killpg(proc.pid, signal.SIGTERM)
            try:
                proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                os.killpg(proc.pid, signal.SIGKILL)
        if handle is not None:
            handle.close()
        shutil.rmtree(tmp, ignore_errors=True)
        if _interactive:
            sys.stdout.write("\r\033[K")
            sys.stdout.flush()


def main():
    args = sys.argv[1:]
    if args == ["--login"]:
        login()
        return 0
    if args == ["--logout"]:
        if os.path.exists(TOKEN_FILE):
            os.remove(TOKEN_FILE)
        print("signed out")
        return 0
    if len(args) != 1 or args[0].startswith("-"):
        print(__doc__.strip().split("\n\n")[0], file=sys.stderr)
        print("\nusage: ytchat <youtube-url> | --login | --logout", file=sys.stderr)
        return 2
    code = watch(args[0])
    if _interactive:
        # The input thread is blocked reading the keyboard, which can hang Python's
        # normal shutdown. Cleanup already ran in watch(), so exit right away.
        sys.stdout.flush()
        os._exit(code)
    return code


if __name__ == "__main__":
    sys.exit(main())
