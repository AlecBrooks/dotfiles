#!/usr/bin/env bash
# yazi, in the active desktop theme's colors (~/bin/theme): a theme can render a theme.toml into
# ~/.cache/wallpaper-theme/theme/yazi/; yazi then runs with that folder as its config home, which
# links back to everything in ~/.config/yazi. Without one this is plain yazi.
# (Shadows the real binary: ~/bin comes first on PATH; opengit puts it first for its windows.)
here="$(dirname "$(readlink -f "$0")")"
real=""
IFS=: read -ra dirs <<<"$PATH"
for d in "${dirs[@]}" /usr/bin; do
    [[ -x "$d/yazi" && "$(readlink -f "$d/yazi")" != "$here/yazi" ]] && { real="$d/yazi"; break; }
done
[[ -n "$real" ]] || { echo "yazi: the real yazi isn't installed" >&2; exit 127; }
tdir="$HOME/.cache/wallpaper-theme/theme/yazi"
if [[ -r "$tdir/theme.toml" && -z "${YAZI_CONFIG_HOME:-}" ]]; then
    conf="${XDG_CONFIG_HOME:-$HOME/.config}/yazi"
    for f in "$conf"/* "$conf"/.[!.]*; do
        [[ -e "$f" && "$(basename "$f")" != theme.toml ]] || continue
        ln -sfn "$f" "$tdir/$(basename "$f")"
    done
    export YAZI_CONFIG_HOME="$tdir"
fi
exec "$real" "$@"
