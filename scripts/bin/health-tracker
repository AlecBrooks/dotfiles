#!/usr/bin/env bash
# health-tracker: run the Health Tracker (~/Applications/health-tracker, synced by Seafile) with a fixed
# window class ("health-tracker", so the bar can focus it), then refresh the bar's log reminder
# when it closes (~/bin/waybar-logme, signal 10).
#
#   health-tracker [data.json]        what the launcher entry and the bar click run
#   health-tracker --install-desktop  write ~/.local/share/applications/health-tracker.desktop (per
#                                   user: a .desktop Exec can't expand $HOME). install.sh runs this.
set -uo pipefail

app="$HOME/Applications/health-tracker/health_tracker.py"

if [[ "${1:-}" == --install-desktop ]]; then
    mkdir -p "$HOME/.local/share/applications"
    cat >"$HOME/.local/share/applications/health-tracker.desktop" <<EOF
[Desktop Entry]
Name=Health Tracker
GenericName=Health log
Comment=Log today's measurements, nutrition and wellbeing (written by ~/bin/health-tracker --install-desktop)
Exec=$HOME/bin/health-tracker
Icon=office-chart-line
Type=Application
Terminal=false
Categories=Utility;
Keywords=health;body;weight;diet;log;tracker;
StartupWMClass=health-tracker
EOF
    echo "health-tracker: wrote $HOME/.local/share/applications/health-tracker.desktop"
    exit 0
fi

if [[ ! -f "$app" ]]; then
    notify-send -a "Health Tracker" "Health Tracker" "$app not found (is the Applications library synced?)"
    exit 1
fi

cd "$(dirname "$app")"
# SDL picks the window class from these (X11 / Wayland); no .pyc files in the synced folder.
export SDL_VIDEO_X11_WMCLASS=health-tracker SDL_VIDEO_WAYLAND_WMCLASS=health-tracker SDL_APP_ID=health-tracker
export PYTHONDONTWRITEBYTECODE=1
status=0
python3 "$app" "$@" || status=$?
pkill -RTMIN+10 -x waybar 2>/dev/null || true
exit "$status"
