#!/usr/bin/env bash
# body-tracker: run the Body Tracker (~/Applications/body-tracker, synced by Seafile) with a fixed
# window class ("body-tracker", so the bar can focus it), then refresh the bar's "log me" reminder
# when it closes (~/bin/waybar-logme, signal 10).
#
#   body-tracker [data.json]        what the launcher entry and the bar click run
#   body-tracker --install-desktop  write ~/.local/share/applications/body-tracker.desktop (per
#                                   user: a .desktop Exec can't expand $HOME). install.sh runs this.
set -uo pipefail

app="$HOME/Applications/body-tracker/body_tracker.py"

if [[ "${1:-}" == --install-desktop ]]; then
    mkdir -p "$HOME/.local/share/applications"
    cat >"$HOME/.local/share/applications/body-tracker.desktop" <<EOF
[Desktop Entry]
Name=Body Tracker
GenericName=Body log
Comment=Log today's measurements, nutrition and wellbeing (written by ~/bin/body-tracker --install-desktop)
Exec=$HOME/bin/body-tracker
Icon=office-chart-line
Type=Application
Terminal=false
Categories=Utility;
Keywords=body;weight;diet;log;tracker;
StartupWMClass=body-tracker
EOF
    echo "body-tracker: wrote $HOME/.local/share/applications/body-tracker.desktop"
    exit 0
fi

if [[ ! -f "$app" ]]; then
    notify-send -a "Body Tracker" "Body Tracker" "$app not found (is the Applications library synced?)"
    exit 1
fi

cd "$(dirname "$app")"
# SDL picks the window class from these (X11 / Wayland); no .pyc files in the synced folder.
export SDL_VIDEO_X11_WMCLASS=body-tracker SDL_VIDEO_WAYLAND_WMCLASS=body-tracker SDL_APP_ID=body-tracker
export PYTHONDONTWRITEBYTECODE=1
status=0
python3 "$app" "$@" || status=$?
pkill -RTMIN+10 -x waybar 2>/dev/null || true
exit "$status"
