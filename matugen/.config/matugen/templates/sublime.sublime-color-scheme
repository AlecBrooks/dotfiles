// Generated by matugen (wallpaper-theme). Do not edit; edit the template in
// ~/dotfiles/matugen/.config/matugen/templates/sublime.sublime-color-scheme instead.
// Pair with "theme": "Adaptive.sublime-theme" so the UI chrome follows this scheme.
{
    "name": "Wallpaper",
    "author": "wallpaper-theme (matugen)",

    "variables": {
        "bg":        "{{colors.surface.default.hex}}",
        "bg_hi":     "{{colors.surface_container.default.hex}}",
        "bg_hi2":    "{{colors.surface_container_high.default.hex}}",
        "fg":        "{{colors.on_surface.default.hex}}",
        "fg_dim":    "{{colors.on_surface_variant.default.hex}}",
        "outline":   "{{colors.outline.default.hex}}",
        "primary":   "{{colors.primary.default.hex}}",
        "primary_c": "{{colors.primary_container.default.hex}}",
        "on_primary_c": "{{colors.on_primary_container.default.hex}}",
        "tertiary":  "{{colors.tertiary.default.hex}}",
        "error":     "{{colors.error.default.hex}}",
        "red":       "{{colors.red.default.hex}}",
        "green":     "{{colors.green.default.hex}}",
        "yellow":    "{{colors.yellow.default.hex}}",
        "blue":      "{{colors.blue.default.hex}}",
        "magenta":   "{{colors.magenta.default.hex}}",
        "cyan":      "{{colors.cyan.default.hex}}",
        "orange":    "{{colors.orange.default.hex}}",
    },

    "globals": {
        "foreground":            "var(fg)",
        "background":            "var(bg)",
        "accent":                "var(primary)",
        "caret":                 "var(primary)",
        "line_highlight":        "var(bg_hi)",
        "selection":             "var(primary_c)",
        "selection_foreground":  "var(on_primary_c)",
        "selection_border":      "var(primary_c)",
        "inactive_selection":    "var(bg_hi2)",
        "gutter":                "var(bg)",
        "gutter_foreground":     "var(outline)",
        "guide":                 "var(bg_hi2)",
        "active_guide":          "var(outline)",
        "stack_guide":           "var(bg_hi2)",
        "misspelling":           "var(error)",
        "find_highlight":        "var(yellow)",
        "find_highlight_foreground": "var(bg)",
        "brackets_foreground":   "var(primary)",
        "brackets_options":      "underline",
        "bracket_contents_foreground": "var(primary)",
        "bracket_contents_options": "underline",
        "tags_foreground":       "var(primary)",
        "tags_options":          "underline",
        "shadow":                "color(var(bg) alpha(0.5))",
    },

    "rules": [
        { "name": "Comment",        "scope": "comment, punctuation.definition.comment", "foreground": "var(outline)", "font_style": "italic" },
        { "name": "String",         "scope": "string, punctuation.definition.string", "foreground": "var(green)" },
        { "name": "Number/constant","scope": "constant.numeric, constant.language, constant.character, constant.other", "foreground": "var(orange)" },
        { "name": "Keyword",        "scope": "keyword, storage.modifier, keyword.control", "foreground": "var(magenta)" },
        { "name": "Storage/type",   "scope": "storage.type, support.type, entity.name.type, entity.name.class, support.class", "foreground": "var(yellow)" },
        { "name": "Function",       "scope": "entity.name.function, support.function, meta.function-call variable.function", "foreground": "var(primary)" },
        { "name": "Variable",       "scope": "variable, meta.function-call.arguments", "foreground": "var(fg)" },
        { "name": "Parameter",      "scope": "variable.parameter", "foreground": "var(orange)" },
        { "name": "Operator",       "scope": "keyword.operator", "foreground": "var(cyan)" },
        { "name": "Punctuation",    "scope": "punctuation, meta.brace", "foreground": "var(fg_dim)" },
        { "name": "Tag",            "scope": "entity.name.tag, meta.tag", "foreground": "var(red)" },
        { "name": "Attribute",      "scope": "entity.other.attribute-name", "foreground": "var(yellow)" },
        { "name": "Builtin",        "scope": "support.constant, variable.language", "foreground": "var(cyan)" },
        { "name": "Decorator",      "scope": "meta.annotation, entity.name.decorator", "foreground": "var(tertiary)" },
        { "name": "Invalid",        "scope": "invalid, invalid.illegal", "foreground": "var(bg)", "background": "var(error)" },
        { "name": "Heading",        "scope": "markup.heading, entity.name.section", "foreground": "var(primary)", "font_style": "bold" },
        { "name": "Bold",           "scope": "markup.bold", "font_style": "bold" },
        { "name": "Italic",         "scope": "markup.italic", "font_style": "italic" },
        { "name": "Link",           "scope": "markup.underline.link, string.other.link", "foreground": "var(tertiary)", "font_style": "underline" },
        { "name": "Raw/code",       "scope": "markup.raw, markup.inline.raw", "foreground": "var(cyan)" },
        { "name": "Diff inserted",  "scope": "markup.inserted", "foreground": "var(green)" },
        { "name": "Diff deleted",   "scope": "markup.deleted", "foreground": "var(red)" },
        { "name": "Diff changed",   "scope": "markup.changed", "foreground": "var(yellow)" },
    ],
}
