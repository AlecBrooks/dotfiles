{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "//": "Generated by matugen (wallpaper-theme, workshop theme): the registration-mark emblem and dim LABELS before values, like the bar and the desk.",
  "logo": {
    "type": "kitty",
    "source": "~/.cache/wallpaper-theme/theme/emblem.png",
    "width": 22,
    "height": 11,
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 11 },
    "color": {
      "keys": "{{colors.outline.default.hex}}",
      "title": "{{colors.primary.default.hex}}",
      "separator": "{{colors.outline_variant.default.hex}}",
      "output": "{{colors.on_surface.default.hex}}"
    }
  },
  "modules": [
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "separator", "string": "─" },
    { "type": "os", "key": "OS" },
    { "type": "host", "key": "HOST" },
    { "type": "kernel", "key": "KERNEL" },
    { "type": "uptime", "key": "UPTIME" },
    { "type": "packages", "key": "PACKAGES" },
    { "type": "shell", "key": "SHELL" },
    { "type": "wm", "key": "WM" },
    { "type": "terminal", "key": "TERMINAL" },
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "MEMORY" },
    { "type": "disk", "key": "DISK" },
    { "type": "localip", "key": "LAN" }
  ]
}
