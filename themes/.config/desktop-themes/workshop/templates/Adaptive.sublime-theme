// Generated by matugen (wallpaper-theme, workshop theme): layered over Sublime's Adaptive theme while
// the workshop theme is active; its hook deletes it when switching back. workshop-theme-generated
// Ink sidebar and tabs with hairlines, amber for headings, selection and the open tab.
{
    "rules": [
        { "class": "title_bar", "bg": "{{colors.background.default.hex}}", "fg": "{{colors.on_surface_variant.default.hex}}" },
        { "class": "sidebar_container", "layer0.tint": "{{colors.background.default.hex}}", "layer0.opacity": 1.0 },
        { "class": "sidebar_heading", "fg": "{{colors.primary.default.hex}}", "font.bold": true, "font.size": 11 },
        { "class": "sidebar_label", "fg": "{{colors.on_surface_variant.default.hex}}" },
        { "class": "sidebar_label", "parents": [{ "class": "tree_row", "attributes": ["hover"] }], "fg": "{{colors.on_surface.default.hex}}" },
        { "class": "sidebar_label", "parents": [{ "class": "tree_row", "attributes": ["selected"] }], "fg": "{{colors.yellow.default.hex}}" },
        { "class": "tree_row", "layer0.opacity": 0.0 },
        { "class": "tree_row", "attributes": ["selected"], "layer0.tint": "{{colors.primary_container.default.hex}}", "layer0.opacity": 1.0 },
        { "class": "icon_folder", "layer0.tint": "{{colors.primary.default.hex}}" },
        { "class": "icon_folder_loading", "layer0.tint": "{{colors.primary.default.hex}}" },
        { "class": "icon_folder_dup", "layer0.tint": "{{colors.outline.default.hex}}" },
        { "class": "icon_file_type", "layer0.opacity": 0.75 },
        { "class": "disclosure_button_control", "layer0.tint": "{{colors.outline.default.hex}}" },
        { "class": "tabset_control", "layer0.tint": "{{colors.background.default.hex}}", "layer0.opacity": 1.0 },
        { "class": "tab_control", "layer0.tint": "{{colors.background.default.hex}}", "layer0.opacity": 1.0, "layer1.opacity": 0.0, "layer2.opacity": 0.0 },
        { "class": "tab_control", "attributes": ["selected"], "layer0.tint": "{{colors.surface.default.hex}}", "layer0.opacity": 1.0 },
        { "class": "tab_label", "fg": "{{colors.outline.default.hex}}" },
        { "class": "tab_label", "parents": [{ "class": "tab_control", "attributes": ["selected"] }], "fg": "{{colors.primary.default.hex}}" },
        { "class": "tab_close_button", "layer0.tint": "{{colors.outline.default.hex}}" },
        { "class": "status_bar", "layer0.tint": "{{colors.background.default.hex}}", "layer0.opacity": 1.0 },
        { "class": "label_control", "parents": [{ "class": "status_bar" }], "fg": "{{colors.outline.default.hex}}" },
        { "class": "sidebar_button_control", "layer0.tint": "{{colors.outline.default.hex}}" },
        { "class": "panel_control", "layer0.tint": "{{colors.background.default.hex}}", "layer0.opacity": 1.0 },
        { "class": "overlay_control", "layer0.tint": "{{colors.surface_container.default.hex}}", "layer0.opacity": 1.0 },
        { "class": "puck_control", "layer0.tint": "{{colors.outline_variant.default.hex}}" },
        { "class": "scroll_track_control", "layer0.opacity": 0.0 }
    ]
}
