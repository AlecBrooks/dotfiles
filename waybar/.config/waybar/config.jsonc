// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    "reload_style_on_change": true, // Auto-reload style.css on save, no restart needed
    // "width": 1280, // Waybar width
    "spacing": 0, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "hyprland/workspaces",
        "group/media-drawer",
        "custom/tank"
    ],

    "modules-center": [
        "hyprland/window"
    ],

    "modules-right": [
        "custom/logme",
        "custom/globe",
        "custom/vpn",
        "custom/jarvis",
        "custom/weather",
        "pulseaudio",
        "bluetooth",
        "temperature",
        "custom/gpu",
        "battery",
        "clock",
        "custom/notifications",
        "group/tray-drawer",
        "custom/power"
    ],
    // Modules configuration
    // "sway/workspaces": {
    //     "disable-scroll": true,
    //     "all-outputs": true,
    //     "warp-on-scroll": false,
    //     "format": "{name}: {icon}",
    //     "format-icons": {
    //         "1": "",
    //         "2": "",
    //         "3": "",
    //         "4": "",
    //         "5": "",
    //         "urgent": "",
    //         "focused": "",
    //         "default": ""
    //     }
    // },

    // Workspace numbers mean nothing here (each monitor owns its own set), so show plain dots: solid = showing on its monitor, hollow = not
    "hyprland/workspaces": {
        "format": "{icon}",
        "sort-by": "number",
        "format-icons": {
            "default": "○",
            "active": "●",
            "visible": "●"
        }
    },

    // Click the visualizer to slide out media controls: previous (or restart if the player can't skip), play/pause + what's playing, next (or +10s if it can't skip)
    "group/media-drawer": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 250,
            "transition-left-to-right": true,
            "click-to-reveal": true,
            "children-class": "media-drawer-item"
        },
        "modules": [
            "cava",
            "custom/media-prev",
            "mpris",
            "custom/media-next"
        ]
    },
    "custom/media-prev": {
        "format": "⏮",
        "tooltip": false,
        "on-click": "playerctl previous 2>/dev/null || playerctl position 0"
    },
    "custom/media-next": {
        "format": "⏭",
        "tooltip": false,
        "on-click": "playerctl next 2>/dev/null || playerctl position 10+"
    },
    "mpris": {
        "format": "{status_icon} {title} — {artist}",
        "format-paused": "{status_icon} {title} — {artist}",
        "format-stopped": "",
        "status-icons": {
            "playing": "⏸",
            "paused": "▶"
        },
        "max-length": 50,
        "tooltip-format": "{player}\n{title}\n{artist}{album}",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl stop"
    },

    "cava": {
        "cava_config": "$HOME/.config/waybar/cava.conf",
        "hide_on_silence": false,
        "format-icons": [
            "▁",
            "▂",
            "▃",
            "▄",
            "▅",
            "▆",
            "▇",
            "█"
        ]
    },

    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
    "mpd": {
        "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ⸨{songPosition}|{queueLength}⸩ {volume}% ",
        "format-disconnected": "Disconnected ",
        "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
        "unknown-tag": "N/A",
        "interval": 5,
        "consume-icons": {
            "on": " "
        },
        "random-icons": {
            "off": "<span color=\"#f53c3c\"></span> ",
            "on": " "
        },
        "repeat-icons": {
            "on": " "
        },
        "single-icons": {
            "on": "1 "
        },
        "state-icons": {
            "paused": "",
            "playing": ""
        },
        "tooltip-format": "MPD (connected)",
        "tooltip-format-disconnected": "MPD (disconnected)"
    },
    // Health Tracker reminder: a heart-pulse icon until today has an entry (~/bin/waybar-logme); hidden after.
    // Click opens (or focuses) the tracker; closing it refreshes this via signal 10.
    "custom/logme": {
        "exec": "$HOME/bin/waybar-logme",
        "return-type": "json",
        "interval": 300,
        "signal": 10,
        "on-click": "$HOME/bin/focus-or-launch '^health-tracker$' $HOME/bin/health-tracker"
    },
    // Fish: MyFishTank, with how many creatures are alive (+ an envelope while visitors' notes float in it). Click swaps the wallpaper on
    // that bar's monitor for the tank and back (~/bin/waybar-tank, ~/bin/tank-wallpaper; address in ~/.config/tank-wallpaper.toml)
    "custom/tank": {
        "exec": "$HOME/bin/waybar-tank",
        "return-type": "json",
        "interval": 15,
        "signal": 11,
        "on-click": "$HOME/bin/waybar-tank toggle"
    },
    // Globe: an alert counter from a private script (~/.local/bin, not in this repo).
    "custom/globe": {
        "exec": "$HOME/.local/bin/statusglobe",
        "return-type": "json",
        "interval": 60,
        "signal": 9,
        "on-click": "$HOME/.local/bin/statusglobe open"
    },
    // Padlock: Tailscale exit node (home server -> Proton VPN). Click toggles; ~/bin/waybar-vpn
    "custom/vpn": {
        "exec": "$HOME/bin/waybar-vpn",
        "return-type": "json",
        "interval": 10,
        "signal": 8,
        "on-click": "$HOME/bin/waybar-vpn toggle"
    },
    // Jarvis voice assistant, from a private script (~/.local/bin, not in this repo).
    // White = standing by, half-lit = listening, lit = working/speaking, dim = off.
    // Click: conversation popup. Right-click: turn it on/off.
    "custom/jarvis": {
        "exec": "$HOME/.local/bin/waybar-jarvis",
        "return-type": "json",
        "interval": 30,
        "signal": 12,
        "on-click": "$HOME/.local/bin/waybar-jarvis convo",
        "on-click-right": "$HOME/.local/bin/waybar-jarvis power"
    },
    // Current temperature (KWeather's saved location, via Open-Meteo); click opens/focuses KWeather
    // Bluetooth: dim = off, plain = on, accent + count = devices connected; hidden with no adapter.
    // Click opens bluetui (pair/connect) in its own kitty.
    "bluetooth": {
        "format": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "󰂱 {num_connections}",
        "format-no-controller": "",
        "tooltip-format": "{controller_alias}: {status}",
        "tooltip-format-connected": "{controller_alias}: {num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}  {device_battery_percentage}%",
        "on-click": "$HOME/bin/focus-or-launch '^bluetui$' kitty --class bluetui --title Bluetooth bluetui"
    },
    "custom/weather": {
        "exec": "$HOME/bin/waybar-weather",
        "return-type": "json",
        "interval": 900,
        "on-click": "$HOME/bin/focus-or-launch kweather kweather"
    },
    // GPU hotspot temp; turns amber/red near the driver's limits and sends a notification when hot. ~/bin/waybar-gpu
    "custom/gpu": {
        "exec": "$HOME/bin/waybar-gpu",
        "return-type": "json",
        "interval": 5
    },
    // Battery: only machines that have one show it (Waybar hides it otherwise). Amber below 30%,
    // flashing red below 15% while on battery.
    "battery": {
        "interval": 30,
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "tooltip-format": "{timeTo}\nhealth {health}%, {cycles} cycles, {power:.1f} W"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    // Tray hidden behind the swirl: click it to slide the tray icons out, click again to hide them
    "group/tray-drawer": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 250,
            "transition-left-to-right": false,
            "click-to-reveal": true,
            "children-class": "tray-drawer-item"
        },
        "modules": [
            "image#tray-toggle",
            "tray"
        ]
    },
    // The Air Nomad swirl (regenerated in the theme color by ~/bin/airbender-logo --icon)
    "image#tray-toggle": {
        "exec": "echo \"$HOME/.cache/wallpaper-theme/tray-icon.png\"",
        "size": 20,
        "interval": 60,
        "tooltip": false
    },
    "tray": {
        "icon-size": 21,
        "spacing": 10,
        "icons": {
        "blueman": "bluetooth",
        "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
        }
    },
    // Notification bell (swaync): left-click toggles Do Not Disturb, right-click opens the panel
    "custom/notifications": {
        "exec": "swaync-client -swb",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂚",
            "none": "󰂚",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂛",
            "inhibited-none": "󰂛",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰂛"
        },
        "tooltip-format": "{}  (click: Do Not Disturb, right-click: panel)",
        "on-click": "swaync-client -d -sw",
        "on-click-right": "swaync-client -t -sw",
        "escape": true
    },
    "clock": {
        // "timezone": "America/New_York",
        "format": "{:%I:%M %p}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    // CPU temp (k10temp Tctl). PCI path because the hwmonN number can change between boots.
    // 5600X throttles at 95, so red from 85.
    "temperature": {
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 85,
        "tooltip-format": "CPU (Tctl) {temperatureC}°C",
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "battery#bat2": {
        "bat": "BAT2"
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": ""
      }
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "custom/media": {
        "format": "{icon} {text}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
            "spotify": "",
            "default": "🎜"
        },
        "escape": true,
        "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null" // Script in resources folder
        // "exec": "$HOME/.config/waybar/mediaplayer.py --player spotify 2> /dev/null" // Filter player based on name
    },
    "custom/power": {
        "format": "⏻",
        "align": 0.5,
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/power_menu.xml",
        "menu-actions": {
            "switchuser": "$HOME/bin/switch-user",
            "logout": "uwsm stop",
            "shutdown": "systemctl poweroff",
            "reboot": "systemctl reboot",
            "suspend": "systemctl suspend",
            "hibernate": "systemctl hibernate"
        }
    }
}
